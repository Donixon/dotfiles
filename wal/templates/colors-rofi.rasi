* {{
    bg:       {background};
    bg-light: {color0};
    fg:       {foreground};
    accent:   {color1};
    selected: {color2};
    width:    800px;
}}

window {{
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    15px;
    padding:          0;
}}

mainbox {{
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          8px;
    padding:          12px;
}}

inputbar {{
    children:         [ prompt, entry ];
    background-color: transparent;
    border-radius:    10px;
    padding:          2px;
}}

prompt {{
    background-color: @accent;
    padding:          10px 14px;
    text-color:       @bg;
    border-radius:    10px;
    margin:           0px 6px 0px 0px;
}}

entry {{
    padding:          10px;
    text-color:       @fg;
    background-color: @bg-light;
    border-radius:    10px;
    placeholder:      "Zoeken...";
    placeholder-color: @fg;
}}

listview {{
    padding:          4px 0px 0px;
    columns:          1;
    lines:            8;
    background-color: transparent;
    scrollbar:        false;
}}

element {{
    padding:          8px 10px;
    background-color: transparent;
    border-radius:    10px;
    text-color:       @fg;
    spacing:          8px;
}}

element selected {{
    background-color: @selected;
    text-color:       @fg;
}}

element-icon {{
    size:             32px;
    background-color: transparent;
}}

element-text {{
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}}
