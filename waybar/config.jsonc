{
  "style": "~/.config/waybar/style.css",

  "layer": "top",
  "position": "top",
  "height": 54,

  "modules-left": [
    "hyprland/workspaces",
    "custom/updates",
    "custom/cava"
  ],

  "modules-center": [
    "clock",
    "tray"
  ],

  "modules-right": [
    "custom/cpu",
    "custom/temperature",
    "battery",
    "backlight",
    "pulseaudio",
    "network",
    "custom/vpn",
    "custom/notification",
    "custom/power"
  ],

  "include": "~/.config/waybar/modules.jsonc"
}
